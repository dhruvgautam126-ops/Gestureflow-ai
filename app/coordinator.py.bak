"""FrameCoordinator for HomeGuardAI Stage 3A — Shared Frame Coordination.

One distributor background thread reads the camera's latest CameraFramePacket
and pushes it into a small bounded queue for each enabled detector worker.
Workers call get_packet_queue() to obtain their queue, block on queue.get() in
their own thread, and call publish_result() when inference completes.

The UI compositor reads compose() to fetch an atomically synchronized frame
and results matching the highest common sequence across all enabled workers.
Worker threads never produce annotated frames.
"""

from __future__ import annotations

import enum
import queue
import threading
import time
from dataclasses import dataclass, field
from collections import deque
from typing import Any


# ---------------------------------------------------------------------------
# Configuration constants
# ---------------------------------------------------------------------------

#: Packets buffered per worker before the oldest is silently dropped.
QUEUE_MAX_SIZE: int = 2

#: Bounded history size for clean camera frames and worker results.
HISTORY_SIZE: int = 5


# ---------------------------------------------------------------------------
# Public enumerations and data classes
# ---------------------------------------------------------------------------


class DetectorKind(enum.Enum):
    HUMAN = "human"
    FACE = "face"
    HAND = "hand"


@dataclass(frozen=True)
class WorkerResult:
    """Structured geometry published by one detector for one camera frame.

    Only the fields relevant to the detector's kind are populated; all others
    remain None.  The UI compositor checks kind and draws accordingly.

    source_seq / source_ts identify the CameraFramePacket this result was
    computed from.
    """

    kind: DetectorKind
    source_seq: int
    source_ts: float
    generation: int

    # --- Human detection (DetectorKind.HUMAN) ---
    human_people: int | None = None
    human_pose_draw_data: tuple | None = None

    # --- Face detection (DetectorKind.FACE) ---
    face_detections: tuple | None = None

    # --- Hand detection (DetectorKind.HAND) ---
    hand_candidates: tuple | None = None
    hand_visible_tracks: tuple | None = None


# ---------------------------------------------------------------------------
# FrameCoordinator
# ---------------------------------------------------------------------------


class FrameCoordinator:
    """Distribute camera packets to detectors and collect structured results with atomic composition."""

    def __init__(self, camera_source) -> None:
        # Support both:
        # - object with get_current_packet() method (e.g., CameraCapture instance)
        # - bound method (e.g., camera.get_frame) that returns a CameraFramePacket directly
        if hasattr(camera_source, 'get_current_packet'):
            self._camera_getter = camera_source.get_current_packet
        else:
            # Assume it's a callable that returns CameraFramePacket directly
            self._camera_getter = camera_source
        self._running = False
        self._lock = threading.Lock()
        self._shutdown = threading.Event()

        self._queues: dict[DetectorKind, queue.Queue] = {
            kind: queue.Queue(maxsize=QUEUE_MAX_SIZE) for kind in DetectorKind
        }
        self._enabled: dict[DetectorKind, bool] = {kind: False for kind in DetectorKind}
        self._generations: dict[DetectorKind, int] = {kind: 0 for kind in DetectorKind}
        self._results: dict[DetectorKind, WorkerResult | None] = {kind: None for kind in DetectorKind}

        # Bounded histories (deque with maxlen)
        self._frame_history: deque = deque(maxlen=HISTORY_SIZE)
        self._result_histories: dict[DetectorKind, deque] = {
            kind: deque(maxlen=HISTORY_SIZE) for kind in DetectorKind
        }

        self._distributor_thread: threading.Thread | None = None

    def start(self) -> None:
        """Start the background distributor thread."""
        with self._lock:
            if self._running:
                return
            self._running = True
            self._shutdown.clear()
            self._distributor_thread = threading.Thread(
                target=self._distribute, name="FrameCoordinator-Distributor", daemon=True
            )
            self._distributor_thread.start()

    def stop(self) -> None:
        """Stop the distributor thread and join cleanly."""
        self._shutdown.set()
        with self._lock:
            self._running = False
        if self._distributor_thread and self._distributor_thread.is_alive():
            self._distributor_thread.join(timeout=2.0)
        self._distributor_thread = None

    def enable(self, kind: DetectorKind) -> int:
        """Enable a detector, increment its generation, and return the new generation boundary."""
        with self._lock:
            self._enabled[kind] = True
            self._generations[kind] += 1
            self._results[kind] = None
            _drain(self._queues[kind])
            return self._generations[kind]

    def disable(self, kind: DetectorKind) -> None:
        """Disable a detector, invalidate its generation, and clear queues/results."""
        with self._lock:
            self._enabled[kind] = False
            self._generations[kind] += 1
            self._results[kind] = None
            _drain(self._queues[kind])
            self._result_histories[kind].clear()

    def is_enabled(self, kind: DetectorKind) -> bool:
        """Return True if the detector is currently enabled."""
        with self._lock:
            return self._enabled[kind]

    def get_generation(self, kind: DetectorKind) -> int:
        """Return the current generation counter for a worker."""
        with self._lock:
            return self._generations[kind]

    def get_packet_queue(self, kind: DetectorKind) -> queue.Queue:
        """Return the packet queue for a detector worker."""
        return self._queues[kind]

    def publish_result(self, result: WorkerResult) -> None:
        """Publish a WorkerResult, validating generation and sequence."""
        with self._lock:
            if not self._enabled[result.kind]:
                return
            if result.generation != self._generations[result.kind]:
                return  # Stale generation rejected

            self._results[result.kind] = result
            self._result_histories[result.kind].append(result)

    def compose(self) -> tuple[Any | None, dict[DetectorKind, WorkerResult | None], bool]:
        """Atomically compose the clean frame and results matching the highest common sequence."""
        with self._lock:
            if not self._frame_history:
                return None, {k: None for k in DetectorKind}, True

            enabled_kinds = [k for k, v in self._enabled.items() if v]

            # Collect available sequences in frame history
            frame_seqs = {pkt.seq: pkt for pkt in self._frame_history}
            if not frame_seqs:
                return None, {k: None for k in DetectorKind}, True

            # If no workers are enabled, return the latest frame
            if not enabled_kinds:
                latest_pkt = self._frame_history[-1]
                return latest_pkt.frame.copy(), {k: None for k in DetectorKind}, True

            # Find common sequences present in frame history and all enabled worker result histories
            common_seqs = set(frame_seqs.keys())
            for kind in enabled_kinds:
                worker_seqs = {res.source_seq for res in self._result_histories[kind] if res.generation == self._generations[kind]}
                common_seqs &= worker_seqs

            if not common_seqs:
                # No common sequence across all enabled workers; return latest clean frame with sync=False
                latest_pkt = self._frame_history[-1]
                res_dict = {k: (self._results[k] if k in enabled_kinds else None) for k in DetectorKind}
                return latest_pkt.frame.copy(), res_dict, False

            # Select highest common sequence
            target_seq = max(common_seqs)
            target_pkt = frame_seqs[target_seq]

            res_dict = {}
            for kind in DetectorKind:
                if kind in enabled_kinds:
                    # Find result matching target_seq for this enabled worker
                    matching_res = next(
                        (res for res in self._result_histories[kind] if res.source_seq == target_seq and res.generation == self._generations[kind]),
                        None
                    )
                    res_dict[kind] = matching_res
                else:
                    res_dict[kind] = None

            return target_pkt.frame.copy(), res_dict, True

    def get_latest_result(self, kind: DetectorKind) -> WorkerResult | None:
        """Fetch the most recent WorkerResult for a detector, or None."""
        with self._lock:
            return self._results[kind]

    def get_current_packet(self):
        """Return the latest CameraFramePacket from the camera, or None."""
        return self._camera_getter()

    # ------------------------------------------------------------------
    # Distributor thread
    # ------------------------------------------------------------------

    def _distribute(self) -> None:
        """Push each new camera packet into the queue of every enabled worker with deep-copying and history tracking."""
        last_seq = -1
        while not self._shutdown.is_set():
            packet = self._camera_getter()
            if packet is None or packet.seq == last_seq:
                self._shutdown.wait(0.005)
                continue

            last_seq = packet.seq
            frame_copy_for_history = packet.frame.copy()
            # Construct a packet copy with the deep-copied frame for history
            packet_for_history = type(packet)(packet.seq, packet.timestamp, frame_copy_for_history)

            with self._lock:
                self._frame_history.append(packet_for_history)
                enabled_kinds = [k for k, v in self._enabled.items() if v]

            for kind in enabled_kinds:
                # Each worker gets its own independent frame copy
                frame_copy_for_worker = packet.frame.copy()
                packet_copy = type(packet)(packet.seq, packet.timestamp, frame_copy_for_worker)
                q = self._queues[kind]
                try:
                    q.put_nowait(packet_copy)
                except queue.Full:
                    try:
                        q.get_nowait()
                        q.put_nowait(packet_copy)
                    except (queue.Empty, queue.Full):
                        pass


# ---------------------------------------------------------------------------
# Internal helpers
# ---------------------------------------------------------------------------


def _drain(q: queue.Queue) -> None:
    """Remove all items from a queue without blocking."""
    while not q.empty():
        try:
            q.get_nowait()
        except queue.Empty:
            break
